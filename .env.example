# ============================================================================
# Hy3-295B NVFP4 on 2x DGX Spark — configuration.
# Copy to .env on BOTH nodes:  cp .env.example .env
# Set NODE_RANK/VLLM_HOST_IP per node; the rest is identical on both.
# You only ever run ./start.sh and ./stop.sh from the HEAD.
# (IPs below are RFC-5737 documentation examples — replace with your fabric IPs.)
# ============================================================================

# --- Per-node identity (THE things that differ between the two boxes) --------
NODE_RANK=0                    # head=0, worker=1
VLLM_HOST_IP=192.0.2.1         # THIS node's 200G fabric IP (head=.1, worker=.2 here)

# --- Cluster addresses (fabric IPs; MASTER_ADDR identical on both nodes) ------
MASTER_ADDR=192.0.2.1          # HEAD node's 200G fabric IP
MASTER_PORT=29500
WORKER_HOST=spark2             # worker SSH host/alias (passwordless from head; used by start.sh)

# --- Model / image -----------------------------------------------------------
MODEL=/models
MODEL_DIR=/path/to/Hy3-NVFP4-W4A16   # local dir holding the 181GB checkpoint (bind-mounted :ro)
VLLM_IMAGE=eugr/spark-vllm:latest    # CUDA-13.0 default toolchain (avoids the 222 PTX error)
HF_CACHE=~/.cache/huggingface

# --- Fabric / NCCL (verify: ip -br link ; ibdev2netdev -v) --------------------
NCCL_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_HCA=rocep1s0f0

# --- Verified GB10 recipe (see FINDINGS.md) ----------------------------------
SERVED_NAME=hy3
TP_SIZE=2
NNODES=2
MAX_MODEL_LEN=131072    # 128K ctx at TP=2 / fp8 KV
GMU=0.90                # 0.92 OOMs on ~122GiB GB10
MOE_BACKEND=marlin      # only correct NVFP4-MoE path for W4A16 on SM121
NUM_SPEC_TOKENS=1       # pos-2 MTP acceptance too low => spec-1 wins
MAX_NUM_SEQS=6
KV_CACHE_DTYPE=fp8_e4m3
PORT=8000
ENABLE_TOOLS=0          # 1 => patch hy_v3 parsers + structured tool calls

# --- Ops ---------------------------------------------------------------------
API_TIMEOUT=2400        # seconds start.sh waits for the API (first run is slow)
REPO_DIR_REMOTE=$HOME/hy3-2x-spark   # path to this repo on the worker
EXTRA_ARGS=
